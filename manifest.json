
{
  "manifest_version": 2,
  "name": "Simple Firefox Proxy Restarter",
  "version": "1.1.0",
  "description": "Reset Firefox proxy settings and restore your preferred configuration with one click.",
  "author": "Shahriyar Gilani",
  "homepage_url": "https://github.com/ShahriyarGilani",
  "icons": {
    "32": "icon.svg",
    "48": "icon.svg",
    "64": "icon.svg",
    "96": "icon.svg"
  },
  "permissions": [
    "proxy",
    "menus",
    "storage",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "browser_action": {
    "default_icon": "icon.svg",
    "default_title": "Simple Proxy Restarter"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "system-proxy-restarter@shahriyargilani.github.com",
      "strict_min_version": "91.1"
    }
  }
}